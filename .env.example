# Neon
DATABASE_URL=""

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
# Firma de los webhooks de Clerk (Dashboard → Webhooks → Signing Secret).
# Lo lee `verifyWebhook()` en /api/webhooks/clerk. Formato: whsec_...
CLERK_WEBHOOK_SIGNING_SECRET=""

# Stripe
# Restricted key (rk_...) desde Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=""
# Dashboard → Developers → Webhooks → signing secret, o el que imprime
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe` en local.
STRIPE_WEBHOOK_SECRET=""
STRIPE_CURRENCY="pen"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
